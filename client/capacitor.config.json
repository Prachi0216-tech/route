{
  "appId": "in.myroute.transit",
  "appName": "MyRoute",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f172a",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#0284c7"
    },
    "Geolocation": {
      "permissions": ["location", "coarseLocation"]
    }
  }
}
